# Copy to .env and fill real values. .env is gitignored — never commit real values.

# The bot account's display name shown in-game while it's authenticating
# (bedrock-protocol's `username` option — cosmetic once online-mode auth succeeds).
BOT_USERNAME=MinecraftBot

# Which Realm to join. Leave REALM_ID blank on the very first run — the spike
# falls back to `pickRealm`, which lists the bot account's own joined/owned
# Realms interactively. Once you see the target Realm's ID in that output,
# set REALM_ID here for a deterministic, non-interactive connect.
REALM_ID=

# Opt-in: path to append a JSONL trace of every inbound/outbound packet for the
# life of the process (e.g. RECORD_PACKETS=.secrets/trace.jsonl). Sensitive
# fields (tokens, XUIDs, network/session ids) are redacted before writing —
# see src/recorder.js. Leave blank to disable (default). README → "World
# state + packet recorder".
RECORD_PACKETS=

# The LLM decision loop (#15) reaches the fleet's local hub, never a cloud API.
# Used only by `npm run hub-check` today — the loop itself takes an injected
# model client, so `npm run verify` never reads these and never makes a call.
# The hub has a latest-only model policy: re-read its README before pinning a
# different id rather than trusting this default to have aged well.
LLM_BASE_URL=http://127.0.0.1:8000
LLM_MODEL=claude-haiku-4-5
